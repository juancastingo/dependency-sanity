{
  "name": "@juancastingo/dependency-sanity",
  "version": "0.1.0",
  "description": "Fast, read-only audit tool detecting duplicate dependency versions, unused packages, and phantom imports without altering package.json",
  "bin": {
    "dependency-sanity": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format cjs,esm --dts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "dependencies",
    "dependency-analyzer",
    "npm",
    "lockfile",
    "duplicates",
    "unused-dependencies",
    "phantom-dependencies",
    "audit",
    "cli"
  ],
  "author": "Juan Castin <juancastingo@users.noreply.github.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juancastingo/dependency-sanity.git"
  },
  "bugs": {
    "url": "https://github.com/juancastingo/dependency-sanity/issues"
  },
  "homepage": "https://github.com/juancastingo/dependency-sanity#readme",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.1.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5"
  }
}
